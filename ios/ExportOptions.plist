<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used by `./dev.sh build ipa` (flutter build ipa --export-options-plist=ios/ExportOptions.plist).
  Fill in teamID and provisioningProfiles with Energma's real values once available —
  see docs/IOS_EXPORT.md for how to obtain them. Until then this file only supports
  `signingStyle: automatic` with a team selected locally in Xcode.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>development</string>
	<key>teamID</key>
	<string>REPLACE_WITH_ENERGMA_TEAM_ID</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>uploadBitcode</key>
	<false/>
	<key>compileBitcode</key>
	<false/>
</dict>
</plist>
